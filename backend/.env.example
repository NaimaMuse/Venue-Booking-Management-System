# Server
PORT=5000

# MongoDB — primary connection string (used by backend/config/db.js)
MONGODB_URI=mongodb://127.0.0.1:27017/venue-booking
# Alias accepted by some setups / older docs (same value as MONGODB_URI):
# MONGO_URI=mongodb://127.0.0.1:27017/venue-booking

# Auth — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_string

# Frontend origin(s) for CORS
CLIENT_URL=http://127.0.0.1:5173
# Optional comma-separated origins (e.g. Railway / multiple frontends)
CLIENT_URLS=

# Optional admin seed defaults (npm run seed:admin)
# ADMIN_EMAIL=admin@hargeisahallfinder.com
# ADMIN_PASSWORD=AdminPass123!
# ADMIN_NAME=System Admin
# ADMIN_PHONE=
